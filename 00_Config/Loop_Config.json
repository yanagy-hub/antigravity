{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoopEngineeringGlobalConfig",
  "description": "ループエンジニアリング全体の共通制御パラメータ定義",
  "version": "1.0.0",
  "settings": {
    "max_retries": 3,
    "timeout_seconds": 300,
    "max_token_budget": 100000,
    "deterministic_evaluation": {
      "require_clean_lint": true,
      "require_test_pass": true,
      "allow_warning": false
    },
    "probabilistic_evaluation": {
      "quality_threshold": 0.85,
      "evaluator_model": "Gemini 3.6 Flash"
    },
    "guardrails": {
      "stop_on_repeated_error_count": 2,
      "require_regression_test": true,
      "enforce_sandbox": true
    },
    "logging": {
      "save_iteration_logs": true,
      "log_directory": "90_System/93_Temporary/logs/"
    }
  }
}
